{
  "name": "beadsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "lefthook install",
    "e2e:build": "tsx e2e/issue-list/scripts/build.ts",
    "e2e:issue-list:success": "tsx e2e/issue-list/scripts/run-scenario.ts issues",
    "e2e:issue-list:empty": "tsx e2e/issue-list/scripts/run-scenario.ts empty",
    "e2e:issue-list:atomic-switch": "tsx e2e/issue-list/scripts/run-scenario.ts atomic-switch",
    "e2e:issue-list:child-issues": "tsx e2e/issue-list/scripts/run-scenario.ts child-issues",
    "e2e:issue-list:restoration": "tsx e2e/issue-list/scripts/run-scenario.ts restoration",
    "e2e:issue-list:time-refresh": "tsx e2e/issue-list/scripts/run-scenario.ts time-refresh",
    "e2e:issue-list:focus-refresh": "tsx e2e/issue-list/scripts/run-scenario.ts focus-refresh",
    "e2e:issue-list:complete": "pnpm e2e:issue-list:success && pnpm e2e:issue-list:empty && pnpm e2e:issue-list:atomic-switch && pnpm e2e:issue-list:child-issues && pnpm e2e:issue-list:restoration",
    "e2e:issue-list:order-changed": "pnpm e2e:issue-list:restoration && pnpm e2e:issue-list:child-issues && pnpm e2e:issue-list:atomic-switch && pnpm e2e:issue-list:empty && pnpm e2e:issue-list:success",
    "e2e:issue-list:isolation": "pnpm e2e:issue-list:complete && pnpm e2e:issue-list:order-changed && pnpm e2e:issue-list:complete",
    "e2e:issue-list": "pnpm e2e:issue-list:complete",
    "test:e2e:issue-list": "pnpm e2e:build && pnpm e2e:issue-list:isolation",
    "e2e:settings:phase1": "BEADSMITH_E2E_PHASE=1 pnpm exec wdio run wdio.settings.conf.ts",
    "e2e:settings:phase2": "BEADSMITH_E2E_PHASE=2 pnpm exec wdio run wdio.settings.conf.ts",
    "e2e:settings": "tsx e2e/settings/scripts/run-settings-scenario.ts",
    "test:e2e:settings": "pnpm e2e:build && pnpm e2e:settings",
    "e2e:mermaid": "tsx e2e/mermaid/scripts/run-mermaid-scenario.ts",
    "test:e2e:mermaid": "pnpm e2e:build && pnpm e2e:mermaid"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.1",
    "lucide-react": "^1.34.0",
    "mermaid": "11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "taurpc": "^1.8.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/hast": "3.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@wdio/cli": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.80.0",
    "oxlint-plugin-eslint": "^1.71.0",
    "oxlint-tailwindcss": "^1.10.0",
    "react-doctor": "^0.5.8",
    "tailwindcss": "^4.3.3",
    "tauri-agent-tools": "^0.8.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.7",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
